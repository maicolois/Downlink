{
  "name": "downlink",
  "version": "1.2.0",
  "description": "Downlink — Conversor de YouTube, X, Instagram, TikTok, Reddit y Twitch a MP3/MP4",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js ios/tests/*.test.js",
    "test:ios": "node ios/scripts/test-pwa.mjs",
    "test:pwa": "npm run test:ios",
    "icons:ios": "node ios/scripts/render-icons.mjs",
    "icons:pwa": "npm run icons:ios"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright-core": "^1.63.0",
    "uuid": "^10.0.0"
  }
}
