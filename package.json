{
  "name": "downlink",
  "version": "1.2.0",
  "description": "Downlink — Conversor de YouTube, X, Instagram, TikTok, Reddit y Twitch a MP3/MP4",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/register-aliases.mjs --watch server/index.js",
    "start": "node --import ./scripts/register-aliases.mjs server/index.js",
    "test": "node --import ./scripts/register-aliases.mjs --test tests/*.test.js ios-embedded/tests/*.test.js",
    "test:ios": "node --import ./scripts/register-aliases.mjs ios/Scripts/test-engine.mjs",
    "test:ios-embedded": "node --import ./scripts/register-aliases.mjs ios-embedded/scripts/test-pwa.mjs",
    "test:pwa": "npm run test:ios-embedded",
    "icons:ios-embedded": "node --import ./scripts/register-aliases.mjs ios-embedded/scripts/render-icons.mjs",
    "icons:pwa": "npm run icons:ios-embedded"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright-core": "^1.63.0",
    "uuid": "^10.0.0"
  }
}
