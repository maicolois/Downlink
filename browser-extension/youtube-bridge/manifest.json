{
  "manifest_version": 3,
  "name": "Downlink · YouTube local",
  "version": "1.1.0",
  "description": "Conecta de forma automática la sesión local de YouTube de Chrome con Downlink.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
